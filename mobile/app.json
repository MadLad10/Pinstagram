{
  "expo": {
    "name": "Pinstagram",
    "slug": "pinstagram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pinstagram.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby places and transport options.",
        "NSPhotoLibraryUsageDescription": "Gallery access is needed to pick photos for posts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pinstagram.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to show nearby places and how to get there."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gallery access lets you pick photos to post.",
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "scheme": "pinstagram",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Pinstagram",
      "shortName": "Pinstagram",
      "themeColor": "#E91E63",
      "backgroundColor": "#ffffff"
    }
  }
}
