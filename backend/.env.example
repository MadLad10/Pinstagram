DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/bdvisual
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change_me_run_openssl_rand_hex_32
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

S3_ENDPOINT=http://localhost:9000
# URL phones/browsers use for media and uploads (use your LAN IP on a real device)
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bdvisual-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Leave SMTP_HOST empty to print emails (verification codes) to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

CORS_ORIGINS=http://localhost:3001,http://localhost:8081
RATE_LIMIT_ENABLED=true

ENV=local

# --- AI features (all free options) -------------------------------------
# Local: run Ollama, then `ollama pull qwen2.5:3b-instruct && ollama pull bge-m3`.
# Hosted free tier: Gemini via its OpenAI-compatible endpoint (see README).
AI_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b-instruct
LLM_FREE_TIER=true
EMBEDDING_MODEL=bge-m3
EMBEDDING_MIN_SIMILARITY=0.45
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=
ASSISTANT_MAX_STEPS=6
ASSISTANT_TOOL_TIMEOUT_S=8
ASSISTANT_TIMEOUT_S=90
ASSISTANT_DAILY_TOKENS=60000
